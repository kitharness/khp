{
  "name": "@kitharness/conformance",
  "version": "0.1.0",
  "description": "khp check: tests a kit's MCP server against the Kit Harness Protocol (KHP), tier by tier.",
  "license": "Apache-2.0",
  "homepage": "https://kitharness.org/conformance/",
  "repository": { "type": "git", "url": "git+https://github.com/kitharness/khp.git", "directory": "tools/conformance" },
  "publishConfig": { "access": "public" },
  "type": "module",
  "bin": { "khp": "./dist/cli.js" },
  "files": ["dist"],
  "engines": { "node": ">=22.18" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts",
    "khp": "node src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "8.17.1",
    "pngjs": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "22.18.12",
    "@types/pngjs": "6.0.5",
    "typescript": "5.9.3"
  }
}
